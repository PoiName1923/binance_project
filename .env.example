# ============= MINIO =============
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=binance-trades
# Choose sink target for Flink: clickhouse | minio | both
SINK_TARGET=clickhouse

# ============= KAFKA =============
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_TOPIC=binance-trades

# ============= CLICKHOUSE ============
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=binance_trades
CLICKHOUSE_RAW_TABLE=raw_trades
CLICKHOUSE_AGG_TABLE=aggregated_trades
